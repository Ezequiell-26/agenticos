{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agenticos.dev/schemas/provider-call.v1.json",
  "title":"AgentiCOS Provider Call v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","requestId","providerId","model","messages"],
  "properties":{
    "schemaVersion":{"const":1},
    "requestId":{"type":"string","minLength":1},
    "providerId":{"type":"string","minLength":1},
    "model":{"type":"string","minLength":1},
    "messages":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["role","content"],"properties":{"role":{"enum":["system","developer","user","assistant","tool"]},"content":{"type":"string"}}}},
    "stream":{"type":"boolean"},
    "capabilities":{"type":"array","items":{"type":"string"}}
  }
}
