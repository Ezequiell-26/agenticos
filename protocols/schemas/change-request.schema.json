{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.dev/schemas/change-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "AgentiCOS Change Request v1",
  "required": [
    "schemaVersion",
    "changeId",
    "requestId",
    "scope",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "changeId": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "state": {
      "enum": [
        "proposed",
        "analyzing",
        "verifying",
        "awaiting-approval",
        "promoted",
        "rejected",
        "rolled-back"
      ]
    },
    "referenceEvidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verificationEvidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "snapshotId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
