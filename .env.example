# Never commit real API keys.
# AgentiCOS uses one OpenAI-compatible runtime endpoint per process.
AGENTICOS_API_KEY=
AGENTICOS_PROVIDER_URL=https://api.openai.com/v1/chat/completions
AGENTICOS_PROVIDER_NAME=openai-compatible
AGENTICOS_MODEL=gpt-4o-mini

# Persistent local SQLite database.
AGENTICOS_DATABASE_URL=sqlite://agenticos.db?mode=rwc

# Optional HTTP bind configuration.
AGENTICOS_BIND_HOST=127.0.0.1
AGENTICOS_BIND_PORT=8080

# Examples of compatible gateways/providers:
# AGENTICOS_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
# AGENTICOS_PROVIDER_NAME=openrouter
# AGENTICOS_PROVIDER_URL=https://api.groq.com/openai/v1/chat/completions
# AGENTICOS_PROVIDER_NAME=groq
# AGENTICOS_PROVIDER_URL=https://api.deepseek.com/chat/completions
# AGENTICOS_PROVIDER_NAME=deepseek
