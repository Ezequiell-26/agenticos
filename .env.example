# Never commit real API keys.
# AgentiCOS uses one OpenAI-compatible runtime endpoint per process.
AGENTICOS_API_KEY=
AGENTICOS_PROVIDER_URL=https://api.openai.com/v1/chat/completions
AGENTICOS_PROVIDER_NAME=openai-compatible
AGENTICOS_MODEL=gpt-4o-mini

# Persistent local SQLite database.
AGENTICOS_DATABASE_URL=sqlite://agenticos.db?mode=rwc

# Optional HTTP bind configuration.
AGENTICOS_BIND_HOST=127.0.0.1
AGENTICOS_BIND_PORT=8080

# Examples of compatible gateways/providers:
# AGENTICOS_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
# AGENTICOS_PROVIDER_NAME=openrouter
# AGENTICOS_PROVIDER_URL=https://api.groq.com/openai/v1/chat/completions
# AGENTICOS_PROVIDER_NAME=groq
# AGENTICOS_PROVIDER_URL=https://api.deepseek.com/chat/completions
# AGENTICOS_PROVIDER_NAME=deepseek

# Frontend runtime API target (Tauri and local Vite default).
VITE_AGENTICOS_API_URL=http://127.0.0.1:8080

# Runtime efficiency controls. Defaults are conservative and adapt agent concurrency to CPU count.
AGENTICOS_MAX_AGENT_CONCURRENCY=
AGENTICOS_MAX_CACHED_SESSIONS=256
AGENTICOS_SESSION_RECOVERY_HISTORY_LIMIT=64
AGENTICOS_MEMORY_HISTORY_LIMIT=64
AGENTICOS_MAX_PROMPT_SKILLS=32
AGENTICOS_SKILL_TOTAL_BYTES=8388608

# AI context budget.
AGENTICOS_CONTEXT_WINDOW=8192
AGENTICOS_RESERVED_OUTPUT_TOKENS=2048

# Shared provider HTTP transport and concurrency.
AGENTICOS_PROVIDER_MAX_CONCURRENCY=
AGENTICOS_PROVIDER_TIMEOUT_MS=120000
AGENTICOS_PROVIDER_CONNECT_TIMEOUT_MS=10000
AGENTICOS_HTTP_MAX_IDLE_PER_HOST=8
AGENTICOS_HTTP_POOL_IDLE_TIMEOUT_MS=90000

# MCP: servers are lazy-started, sessions are reused, and tool discovery is cached.
AGENTICOS_MCP_MAX_CONCURRENCY=16
AGENTICOS_MCP_MAX_ACTIVE_SESSIONS=32
AGENTICOS_MCP_TOOL_CACHE_TTL_MS=300000
AGENTICOS_MCP_TOOL_CACHE_MAX_ENTRIES=256

# Global native/MCP tool execution bound; default adapts to CPU count.
AGENTICOS_TOOL_MAX_CONCURRENCY=

# Avoid repeated provider discovery during health monitoring.
AGENTICOS_PROVIDER_HEALTH_CACHE_TTL_MS=30000
