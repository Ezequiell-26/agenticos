{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agenticos.dev/schemas/webhook-trigger.v1.json",
  "title":"AgentiCOS Webhook Trigger v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","triggerId","requestId","eventType","payload","receivedAt"],
  "properties":{
    "schemaVersion":{"const":1},
    "triggerId":{"type":"string","minLength":1},
    "requestId":{"type":"string","minLength":1},
    "eventType":{"type":"string","minLength":1},
    "payload":{"type":"object"},
    "receivedAt":{"type":"string","format":"date-time"},
    "signatureValid":{"type":"boolean"},
    "replayKey":{"type":"string","minLength":1}
  }
}
