{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.dev/schemas/trajectory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "AgentiCOS Trajectory v1",
  "required": [
    "schemaVersion",
    "trajectoryId",
    "runId",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "trajectoryId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "redactionPolicy": {
      "type": "object"
    },
    "retention": {
      "type": "object"
    }
  }
}
