    "Translate the requested feature into capability IDs.",
    "Resolve exact named repositories before broad search.",
    "Read the entire relevant repository evidence pack.",
    "Record repository, ref, commit, license evidence and relevant paths.",
    "Compare the strongest applicable references.",
    "Choose the architecture seam already supported by AgentiCOS contracts.",
    "Only create a new seam when evidence shows existing seams are insufficient.",
    "Write the implementation step with its reference evidence before coding.",
    "Implement only that step.",
    "Run verification and record evidence before unlocking the next step."
  ],
  "dynamic_discovery": {
    "enabled": true,
    "search_source": "GitHub",
    "seed_catalog": "reference/manifests/mit-repositories.json",
    "update_rule": "A newly discovered repository is not canonical until its license, dependency surface, provenance, security and relevant source evidence have been audited.",
    "freshness_rule": "Re-resolve default branch and upstream changes before each integration; preserve the prior pinned commit in evidence for reproducibility."
  }
