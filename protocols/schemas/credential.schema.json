{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.dev/schemas/credential.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "AgentiCOS Credential v1",
  "required": [
    "schemaVersion",
    "credentialId",
    "kind",
    "providerId",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "credentialId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "api-key",
        "oauth-access",
        "oauth-refresh",
        "service-account"
      ]
    },
    "providerId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "active",
        "expiring",
        "expired",
        "revoked",
        "quarantined"
      ]
    },
    "accountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "poolId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
