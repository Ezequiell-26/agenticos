{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agenticos.dev/schemas/provider-descriptor.v1.json",
  "title":"AgentiCOS Provider Descriptor v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","providerId","kind","version","capabilities","protocols"],
  "properties":{
    "schemaVersion":{"const":1},
    "providerId":{"type":"string","minLength":1},
    "kind":{"enum":["model","memory","search","browser","artifact","storage","sandbox","channel"]},
    "version":{"type":"string","minLength":1},
    "capabilities":{"type":"array","items":{"type":"string"}},
    "protocols":{"type":"array","items":{"type":"string"}},
    "configurationSchema":{"type":["object","null"]},
    "provenance":{"type":["object","null"]}
  }
}
