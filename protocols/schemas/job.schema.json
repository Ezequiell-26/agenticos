{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.dev/schemas/job.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "AgentiCOS Job v1",
  "required": [
    "schemaVersion",
    "jobId",
    "runId",
    "kind",
    "state",
    "owner"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "process",
        "terminal",
        "subagent",
        "workflow",
        "scheduled"
      ]
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "cancelling",
        "completed",
        "failed",
        "cancelled",
        "orphaned"
      ]
    },
    "owner": {
      "type": "string"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
