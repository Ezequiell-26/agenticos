{
  "schema_version": 1,
  "purpose": "Reference resolver for no-invention, repository-first architecture and implementation work.",
  "resolution_order": [
    "exact-user-repository-or-URL",
    "exact-catalog-repository",
    "capability-parity-mapped-repositories",
    "GitHub-repository-search-by-capability",
    "license-admission-audit",
    "full-repository-evidence-pack",
    "exact-commit-pin-before-source-integration"
  ],
  "selection_policy": {
    "exact_repo_hint_wins": true,
    "license_required_before_source_use": true,
    "full_repo_evidence_required_for_nontrivial_work": true,
    "dependency_audit_required_before_integration": true,
    "no_readme_only_decisions": true,
    "no_source_without_provenance": true,
    "no_architecture_claim_without_evidence": true,
    "fail_closed_on_missing_evidence": true,
    "non_mit_reference_can_inform_comparison_but_not_supply_canonical_source": true
  },
  "evidence_pack_required": [
    "README and documentation",
    "repository tree and module boundaries",
    "source files relevant to requested capability",
    "tests and fixtures",
    "build/package manifests and lockfiles",
    "CI workflows and quality gates",
    "security policy/advisories",
    "LICENSE/COPYING and path-level notices",
    "dependency/license graph",
    "configuration/examples",
    "relevant changelog/release history",
    "failure/recovery behavior"
  ],
  "license_admission": {
    "canonical_source": "MIT",
    "acceptable_statuses": [
      "verified-mit",
      "verified-mit-with-explicit-excluded-paths"
    ],
    "reject_statuses": [
      "unknown",
      "unverified",
      "non-mit-only",
      "license-transition",
      "missing-path-license"
    ],
    "required_checks": [
      "root-license",
      "package-metadata-license",
      "path-level-overrides",
      "bundled-dependencies",
      "third-party-notices"
    ]
  },
