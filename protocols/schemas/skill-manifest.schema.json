{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agenticos.dev/schemas/skill-manifest.v1.json",
  "title":"AgentiCOS Skill Manifest v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","skillId","version","description","entrypoint","requires"],
  "properties":{
    "schemaVersion":{"const":1},
    "skillId":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "description":{"type":"string"},
    "entrypoint":{"const":"SKILL.md"},
    "requires":{"type":"array","items":{"type":"string"}},
    "triggers":{"type":"array","items":{"type":"string"}},
    "scopes":{"type":"array","items":{"enum":["profile","user","workspace","project","thread","run"]}},
    "provenance":{"type":"object"}
  }
}
