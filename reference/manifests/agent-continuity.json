{
  "schema_version": 2,
  "purpose": "Durable AI project memory and anti-regression control plane for capability-driven continuous development.",
  "canonical_state_file": "reference/PROJECT-STATE.md",
  "append_only_journal": "reference/journal/agent-operations.jsonl",
  "report_template": "reference/journal/AGENT-OPERATION-TEMPLATE.md",
  "required_agent_protocol": "docs/architecture/AGENT-CONTINUITY-PROTOCOL.md",
  "policies": {
    "read_state_before_action": true,
    "read_latest_journal_before_action": true,
    "report_before_action": true,
    "report_after_action": true,
    "next_step_must_be_explicit": true,
    "claims_require_evidence": true,
    "no_memory_from_model_context_only": true,
    "no_untracked_changes": true,
    "no_destructive_operations_by_default": true,
    "deletion_requires_explicit_authorization": true,
    "deletion_requires_snapshot": true,
    "deletion_requires_rollback_plan": true,
    "deletion_requires_journal_entry": true,
    "overwrite_requires_preservation_or_snapshot": true,
    "regression_is_blocking": true,
    "fail_closed_on_missing_state": true,
    "never_claim_tests_passed_without_recorded_evidence": true,
    "never_reset_or_rewrite_history": true,
    "duplicate_json_keys_are_blocking": true,
    "verified_slice_does_not_equal_production_completeness": true,
    "parallel_workstreams_allowed": true,
    "sequential_implementation_disabled": true,
    "capability_level_verification": true,
    "current_state_must_not_block_unrelated_workstreams": true,
    "never_mark_unverified_work_as_verified": true
  },
  "required_operation_fields": [
    "operation_id",
    "timestamp",
    "actor",
    "previous_commit",
    "current_commit",
    "request",
    "scope",
    "status",
    "summary",
    "created",
    "modified",
    "deleted",
    "preserved",
    "verification",
    "risks",
    "rollback",
    "next_step",
    "evidence"
  ],
  "status_machine": [
    "planned",
    "in_progress",
    "verifying",
    "blocked",
    "completed",
    "rolled_back"
  ],
  "protected_assets": [
    "contracts",
    "protocols",
    "reference/manifests",
    "reference/journal",
    "reference/PROJECT-STATE.md",
    "docs/architecture",
    "Cargo.lock",
    "reference/manifests/runtime-integration-gaps.json"
  ],
  "escalation_rule": "When evidence is insufficient, mark the affected capability UNVERIFIED or BLOCKED. Do not freeze unrelated workstreams unless their dependency or security boundary is affected."
}
