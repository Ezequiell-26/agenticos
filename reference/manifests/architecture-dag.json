{
  "schema_version": 4,
  "status": "canonical-structure",
  "layers": {
    "domain": [
      "brain",
      "contracts"
    ],
    "application": [
      "agents",
      "execution",
      "scheduler",
      "workflows"
    ],
    "infrastructure": [
      "a2a",
      "adapters",
      "artifacts",
      "browser",
      "channels",
      "context",
      "evaluation",
      "kernel",
      "mcp",
      "memory",
      "observability",
      "projects",
      "protocols",
      "providers",
      "runtime",
      "sandbox",
      "security",
      "source-forge",
      "terminal",
      "tools",
      "workspace"
    ],
    "presentation": [
      "api-server",
      "cli",
      "desktop",
      "gateway"
    ],
    "utilities": [
      "async-utils",
      "cache",
      "compression",
      "concurrency-stress",
      "configuration",
      "crypto",
      "event-bus",
      "file-watcher",
      "http-client",
      "math",
      "notifications",
      "rate-limiting",
      "sqlite-migrations",
      "state-management",
      "streaming",
      "text-search",
      "time-utils",
      "vector-database",
      "websockets"
    ]
  },
  "planned_crates": {
    "application": [],
    "infrastructure": [
      "plugins",
      "router"
    ]
  },
  "workspace_rules": {
    "one_manifest_per_crate": true,
    "manifest_shape": "crates/<layer>/<crate>/Cargo.toml",
    "one_first_party_owner_per_package": true,
    "all_crates_explicit_workspace_members": true,
    "layer_manifest_must_match_workspace": true,
    "domain_cannot_depend_on_application": true,
    "domain_cannot_depend_on_infrastructure": true,
    "domain_cannot_depend_on_presentation": true,
    "application_cannot_depend_on_presentation": true,
    "utilities_cannot_depend_on_domain": true,
    "utilities_cannot_depend_on_application": true,
    "utilities_cannot_depend_on_presentation": true
  },
  "runtime_rules": {
    "brain_never_depends_on_concrete_provider_tool_mcp_or_surface": true,
    "kernel_owns_durable_runtime_lifecycle_only": true,
    "provider_transport_is_owned_by_infrastructure_providers": true,
    "rust_is_canonical_runtime": true,
    "frontend_is_product_surface": true
  },
  "external_source_policy": {
    "canonical_source_license": "MIT-or-compatibly-licensed",
    "provenance_required": true,
    "integration_modes": [
      "vendored",
      "adapter",
      "isolated-process",
      "knowledge-source"
    ],
    "exact_revision_required_before_source_integration": true
  },
  "scale_rules": {
    "incremental_ingestion": true,
    "bounded_memory": true,
    "bounded_caches": true,
    "backpressure_required": true,
    "selective_retrieval_required": true,
    "spill_large_outputs": true
  },
  "frontend_rules": {
    "desktop_shell": "tauri-2",
    "ui": "react-typescript",
    "bundler": "vite",
    "editor_target": "monaco",
    "transport_abstraction_required": true,
    "component_direct_network_calls": false,
    "durable_state_owned_by_runtime": true,
    "frontend_change_log_required": true
  }
}
