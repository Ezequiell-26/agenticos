{
  "name": "agenticos",
  "version": "0.1.0",
  "private": true,
  "description": "Universal, durable, model-agnostic AI agent runtime.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "check": "npm run typecheck && npm run architecture:check",
    "typecheck": "tsc --noEmit",
    "architecture:check": "tsx src/architecture-cli.ts",
    "test": "node --import tsx --test test/architecture.test.ts",
    "verify": "npm run check && npm run test",
    "dev": "tsx src/cli.ts",
    "providers": "tsx src/cli.ts providers",
    "models": "tsx src/cli.ts models",
    "forge": "tsx src/forge-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
