{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.dev/schemas/code-intelligence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "AgentiCOS Code Intelligence v1",
  "required": [
    "schemaVersion",
    "requestId",
    "workspaceId",
    "operation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "diagnostics",
        "symbols",
        "definition",
        "references",
        "hover",
        "rename",
        "code-action",
        "format"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "position": {
      "type": [
        "object",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
