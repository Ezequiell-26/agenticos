{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.dev/schemas/auxiliary-model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "AgentiCOS Auxiliary Model v1",
  "required": [
    "schemaVersion",
    "requestId",
    "role",
    "parentRunId",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string"
    },
    "role": {
      "enum": [
        "vision",
        "summarization",
        "classification",
        "metadata",
        "repair",
        "review",
        "embedding",
        "reranking",
        "auxiliary-reasoning"
      ]
    },
    "parentRunId": {
      "type": "string"
    },
    "budget": {
      "type": "object"
    },
    "routePolicy": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
